# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/artha-job-feed
MONGODB_DATABASE=artha-job-feed

# Worker Configuration
WORKER_POLL_INTERVAL_MS=500
WORKER_CLAIM_DURATION_MS=30000
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BASE_DELAY_MS=1000

# Provider Verification
PROVIDER_VERIFY_TIMEOUT_MS=5000
PROVIDER_FIXTURE_PATH=./fixtures/provider-plan.json

# Event Retention
EVENT_TTL_DAYS=7

# Logging
LOG_LEVEL=info
