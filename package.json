{
  "name": "artha-job-feed-ingestion",
  "version": "1.0.0",
  "description": "Job feed ingestion service with MongoDB and concurrent workers",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts --ext .ts",
    "lint:fix": "eslint src tests scripts --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "test": "vitest run --dir tests/unit",
    "test:watch": "vitest --dir tests/unit",
    "test:integration": "vitest run --dir tests/integration",
    "test:all": "vitest run",
    "demo": "tsx scripts/demo.ts",
    "load": "tsx scripts/load.ts"
  },
  "keywords": [
    "job-feed",
    "ingestion",
    "mongodb",
    "worker",
    "typescript"
  ],
  "author": "Harshit Makwana",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "fastify": "^4.26.2",
    "mongodb": "^6.5.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.5",
    "tsx": "^4.7.1",
    "typescript": "^5.4.2",
    "vitest": "^1.4.0"
  }
}
